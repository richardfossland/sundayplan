{
  "name": "@sundayplan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'lint: no eslint configured for this app yet — see README/PR; tsc --noEmit (typecheck) is the gate for now'",
    "typecheck": "node scripts/check-i18n.mjs && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo .open-next",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@sundayplan/auth": "workspace:*",
    "@sundayplan/sdk": "workspace:*",
    "@sundayplan/shared": "workspace:*",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.37.0",
    "next": "^15.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
